@prefix acc: <https://w3id.org/d2c/acc#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

acc:ACCOntology a owl:Ontology ;
  owl:imports <http://www.w3.org/ns/prov-o> ;
  dcterms:conformsTo <http://www.w3.org/ns/prov-o> ;
  rdfs:label "D2C_13_2 Auditable Causal Contract Ontology" ;
  rdfs:comment "Lightweight exchange ontology aligned with PROV-O for provenance records. No OWL-DL reasoning claim is made." .

acc:Artifact a owl:Class ; rdfs:subClassOf prov:Entity .
acc:Document a owl:Class ; rdfs:subClassOf prov:Entity .
acc:Span a owl:Class ; rdfs:subClassOf prov:Entity .
acc:Entity a owl:Class ; rdfs:subClassOf prov:Entity .
acc:Assertion a owl:Class ; rdfs:subClassOf prov:Entity .
acc:Condition a owl:Class ; rdfs:subClassOf prov:Entity .
acc:RetainedEdge a owl:Class ; rdfs:subClassOf prov:Entity .
acc:ArtifactCompilationActivity a owl:Class ; rdfs:subClassOf prov:Activity .
acc:DirectCoreEdge a owl:Class ; rdfs:subClassOf acc:RetainedEdge .
acc:ConditionalEdge a owl:Class ; rdfs:subClassOf acc:RetainedEdge .
acc:RegimeEdge a owl:Class ; rdfs:subClassOf acc:RetainedEdge .
acc:TransitiveDerivedEdge a owl:Class ; rdfs:subClassOf acc:RetainedEdge .
acc:CandidateEdge a owl:Class ; rdfs:subClassOf acc:RetainedEdge .
acc:UnsupportedHypothesisEdge a owl:Class ; rdfs:subClassOf acc:RetainedEdge .
acc:HypothesisEdge a owl:Class ; rdfs:subClassOf acc:RetainedEdge .
acc:RejectedEdge a owl:Class ; rdfs:subClassOf acc:RetainedEdge .
acc:ConflictDecision a owl:Class ; rdfs:subClassOf prov:Entity .
acc:CycleDecision a owl:Class ; rdfs:subClassOf prov:Entity .
acc:Vote a owl:Class ; rdfs:subClassOf prov:Entity .

acc:source a owl:ObjectProperty .
acc:target a owl:ObjectProperty .
acc:hasEntity a owl:ObjectProperty .
acc:hasEdge a owl:ObjectProperty .
acc:hasAssertion a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasDerivedFrom .
acc:hasSpan a owl:ObjectProperty .
acc:hasDocumentSupport a owl:ObjectProperty .
acc:candidateAssertion a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasDerivedFrom .
acc:candidateSpan a owl:ObjectProperty .
acc:candidateDocument a owl:ObjectProperty .
acc:candidateDerivation a owl:ObjectProperty .
acc:condition a owl:ObjectProperty .
acc:derivedFrom a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasDerivedFrom .
acc:ofSpan a owl:ObjectProperty .
acc:ofDocument a owl:ObjectProperty .
acc:selected a owl:ObjectProperty .
acc:pair a owl:ObjectProperty .
acc:decisionEdgeId a owl:ObjectProperty .
acc:removedEdge a owl:DatatypeProperty .
